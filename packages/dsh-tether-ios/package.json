{
  "name": "dsh-tether-ios",
  "version": "0.1.0",
  "description": "DSH Desktop 0.2.0-rc.2 iOS remote companion (macOS arm64, pre-release validation)",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin/darwin-arm64",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.0-rc.2"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "dshReleases": {}
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "author": "Hoya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinahhy/DSH-plugins.git",
    "directory": "packages/dsh-tether-ios"
  }
}
